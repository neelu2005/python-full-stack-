#Lambda Functions
#A lambda function is a small anonymous function created using the lambda keyword.

#Syntax
#lambda arguments: expression
#Example
square = lambda x: x * x
print(square(5))

'''Output:25
Lambda provides a concise way to write simple functions.'''

'''sorted() with Lambda
Lambda functions are especially useful with sorted() when we want to specify which value should be used for sorting.'''

#Sort Tuples by Marks
students = [
    ("Rahul", 80),
    ("Anil", 95),
    ("Kiran", 70),
    ("Suresh", 85)
]
result = sorted(students, key=lambda x: x[1])
print(result)
'''Output:[('Kiran', 70), ('Rahul', 80), ('Suresh', 85), ('Anil', 95)]
Here:
key=lambda x: x[1]'''

#means Python takes the second value from each tuple and uses it for sorting.

#Sort in Descending Order

#Use reverse=True.
students = [
    ("Rahul", 80),
    ("Anil", 95),
    ("Kiran", 70),
    ("Suresh", 85)
]
result = sorted(
    students,
    key=lambda x: x[1],
    reverse=True
)
print(result)

#Output: [('Anil', 95), ('Suresh', 85), ('Rahul', 80), ('Kiran', 70)]

#Sort by Name
students = [
    ("Rahul", 80),
    ("Anil", 95),
    ("Kiran", 70),
    ("Suresh", 85)
]
result = sorted(students, key=lambda x: x[0])
print(result)

'''Output:[('Anil', 95), ('Kiran', 70), ('Rahul', 80), ('Suresh', 85)]
Here:
lambda x: x[0]'''

#selects the first value of each tuple.

#Sorting a List of Dictionaries
#Lambda can also be used to sort dictionaries based on a particular key.

students = [
    {"name": "Rahul", "marks": 80},
    {"name": "Anil", "marks": 95},
    {"name": "Kiran", "marks": 70},
    {"name": "Suresh", "marks": 85}
]
result = sorted(students, key=lambda x: x["marks"])
print(result)

'''Output:

[
    {'name': 'Kiran', 'marks': 70},
    {'name': 'Rahul', 'marks': 80},
    {'name': 'Suresh', 'marks': 85},
    {'name': 'Anil', 'marks': 95}
]'''

'''Here:

lambda x: x["marks"]

means:'''

'''Take each dictionary
       ↓Get the "marks" value
       ↓Use it as the sorting key'''

#Sorting Dictionaries in Descending Order
result = sorted(
    students,
    key=lambda x: x["marks"],
    reverse=True
)


print(result)

'''Output:

[
    {'name': 'Anil', 'marks': 95},
    {'name': 'Suresh', 'marks': 85},
    {'name': 'Rahul', 'marks': 80},
    {'name': 'Kiran', 'marks': 70}
]'''

#Sort Strings by Length
names = ["Ravi", "Alexander", "John", "Sai"]
result = sorted(names, key=lambda x: len(x))
print(result)

#Output:['Sai', 'Ravi', 'John', 'Alexander']

#For descending order:
result = sorted(names, key=lambda x: len(x), reverse=True)
print(result)

#Output:['Alexander', 'Ravi', 'John', 'Sai']

